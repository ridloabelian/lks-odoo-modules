<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ====================================================================== -->
    <!-- INHERIT RES.PARTNER FORM VIEW (BUKU INDUK PPKS TAB)                    -->
    <!-- ====================================================================== -->
    <record id="view_partner_form_lks_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.lks.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_admission_registers"
                        icon="fa-book" invisible="not is_ppks">
                    <field name="admission_count" widget="statinfo" string="Buku Induk"/>
                </button>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Buku Induk &amp; PPKS LKS" name="ppks_social_welfare" invisible="not is_ppks">
                    <group>
                        <group string="Identitas Registrasi PPKS">
                            <field name="registration_number" readonly="1"/>
                            <field name="ppks_category_id" required="is_ppks"/>
                            <field name="ppks_cluster"/>
                            <field name="ppks_secondary_category_ids" widget="many2many_tags"
                                   options="{'color_field': 'sequence'}"/>
                        </group>
                        <group string="Status Residensial &amp; Siklus Layanan">
                            <field name="residential_status" widget="radio"/>
                            <field name="service_status" widget="badge"
                                   decoration-info="service_status in ['intake', 'assessment']"
                                   decoration-success="service_status == 'active'"
                                   decoration-warning="service_status == 'pre_reunion'"
                                   decoration-muted="service_status in ['discharged', 'follow_up']"/>
                            <label for="intake_date" string="Periode Pelayanan"/>
                            <div class="o_row">
                                <field name="intake_date"/> s/d <field name="discharge_date"/>
                            </div>
                            <field name="duration_of_stay"/>
                        </group>
                    </group>

                    <group>
                        <group string="Fasilitas Hunian Panti" invisible="residential_status != 'in_facility'">
                            <field name="dormitory_id" options="{'no_create': True}"/>
                            <field name="room_id" options="{'no_create': True}"/>
                            <field name="bed_number"/>
                        </group>
                        <group string="Sumber Rujukan Klien">
                            <field name="referral_source"/>
                            <field name="referral_notes" placeholder="No. Surat Pengantar / Keterangan Perujuk..."/>
                        </group>
                    </group>

                    <group>
                        <group string="Data Wali / Kontak Keluarga Penanggung Jawab">
                            <field name="guardian_id"/>
                            <field name="guardian_relation"/>
                            <field name="guardian_phone"/>
                            <field name="guardian_address"/>
                        </group>
                        <group string="Petugas Pendamping (Pekerja Sosial / Peksos)">
                            <field name="social_worker_id"/>
                            <field name="peksos_registration_no"/>
                            <field name="peksos_phone"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ====================================================================== -->
    <!-- DEDICATED TREE / LIST VIEW FOR PPKS CLIENTS                            -->
    <!-- ====================================================================== -->
    <record id="view_lks_ppks_client_tree" model="ir.ui.view">
        <field name="name">lks.ppks.client.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Buku Induk Klien PPKS" default_order="intake_date desc, id desc">
                <field name="registration_number"/>
                <field name="name" string="Nama Klien PPKS"/>
                <field name="nik"/>
                <field name="gender"/>
                <field name="age"/>
                <field name="ppks_category_id" widget="badge"/>
                <field name="residential_status" widget="badge"
                       decoration-success="residential_status == 'in_facility'"
                       decoration-info="residential_status == 'day_care'"
                       decoration-muted="residential_status == 'out_facility'"/>
                <field name="dormitory_id" optional="show"/>
                <field name="room_id" optional="show"/>
                <field name="bed_number" optional="hide"/>
                <field name="service_status" widget="badge"
                       decoration-info="service_status in ['intake', 'assessment']"
                       decoration-success="service_status == 'active'"
                       decoration-warning="service_status == 'pre_reunion'"
                       decoration-muted="service_status in ['discharged', 'follow_up']"/>
                <field name="intake_date"/>
                <field name="social_worker_id" optional="show"/>
                <field name="guardian_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ====================================================================== -->
    <!-- DEDICATED KANBAN VIEW FOR PPKS CLIENTS                                 -->
    <!-- ====================================================================== -->
    <record id="view_lks_ppks_client_kanban" model="ir.ui.view">
        <field name="name">lks.ppks.client.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="registration_number"/>
                <field name="image_128"/>
                <field name="gender"/>
                <field name="age"/>
                <field name="ppks_category_id"/>
                <field name="residential_status"/>
                <field name="service_status"/>
                <field name="dormitory_id"/>
                <field name="room_id"/>
                <field name="social_worker_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill p-3">
                            <t t-if="record.image_128.raw_value">
                                <field name="image_128" widget="image" class="o_kanban_image_fill_left" options="{'zoom': true}"/>
                            </t>
                            <t t-else="">
                                <div class="o_kanban_image_fill_left d-flex align-items-center justify-content-center bg-light text-muted">
                                    <i class="fa fa-user fa-3x" title="Foto Klien"/>
                                </div>
                            </t>
                            <div class="oe_kanban_details ps-2">
                                <div class="o_kanban_record_top mb-1">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title fs-6"><field name="name"/></strong>
                                        <div class="text-muted small">
                                            <span class="badge text-bg-light border"><field name="registration_number"/></span>
                                            <span class="ms-1"><field name="gender"/>, <field name="age"/> Thn</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-1">
                                    <span class="badge text-bg-primary"><field name="ppks_category_id"/></span>
                                </div>
                                <div class="small text-muted mb-1" t-if="record.residential_status.raw_value == 'in_facility'">
                                    <i class="fa fa-bed me-1 text-primary" title="Kamar Asrama"/> <field name="dormitory_id"/> - <field name="room_id"/>
                                </div>
                                <div class="o_kanban_record_bottom mt-2 pt-1 border-top">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="residential_status" widget="badge"/>
                                        <field name="service_status" widget="badge"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="social_worker_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ====================================================================== -->
    <!-- DEDICATED SEARCH VIEW FOR PPKS CLIENTS                                 -->
    <!-- ====================================================================== -->
    <record id="view_lks_ppks_client_search" model="ir.ui.view">
        <field name="name">lks.ppks.client.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Pencarian Klien PPKS">
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('registration_number', 'ilike', self), ('nik', 'ilike', self)]"/>
                <field name="registration_number"/>
                <field name="nik"/>
                <field name="ppks_category_id"/>
                <field name="dormitory_id"/>
                <field name="room_id"/>
                <field name="social_worker_id"/>
                <separator/>
                <filter string="Residensial (Dalam Panti)" name="filter_in_facility" domain="[('residential_status', '=', 'in_facility')]"/>
                <filter string="Day Care" name="filter_day_care" domain="[('residential_status', '=', 'day_care')]"/>
                <filter string="Luar Panti (Bina Keluarga)" name="filter_out_facility" domain="[('residential_status', '=', 'out_facility')]"/>
                <separator/>
                <filter string="Layanan Aktif" name="filter_active_service" domain="[('service_status', 'in', ['intake', 'assessment', 'active'])]"/>
                <filter string="Persiapan Reuni / Terminasi" name="filter_pre_reunion" domain="[('service_status', '=', 'pre_reunion')]"/>
                <filter string="Sudah Terminasi" name="filter_discharged" domain="[('service_status', '=', 'discharged')]"/>
                <separator/>
                <filter string="Anak-anak (0 - 17 Thn)" name="filter_children" domain="[('age', '&lt;', 18)]"/>
                <filter string="Lanjut Usia (&gt;= 60 Thn)" name="filter_elderly" domain="[('age', '&gt;=', 60)]"/>
                <group name="group_by">
                    <filter string="Kategori PPKS" name="group_by_ppks" context="{'group_by': 'ppks_category_id'}"/>
                    <filter string="Status Residensial" name="group_by_residence" context="{'group_by': 'residential_status'}"/>
                    <filter string="Status Layanan" name="group_by_service" context="{'group_by': 'service_status'}"/>
                    <filter string="Asrama" name="group_by_dormitory" context="{'group_by': 'dormitory_id'}"/>
                    <filter string="Kamar" name="group_by_room" context="{'group_by': 'room_id'}"/>
                    <filter string="Pekerja Sosial (Peksos)" name="group_by_peksos" context="{'group_by': 'social_worker_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ====================================================================== -->
    <!-- WINDOW ACTIONS FOR PPKS CLIENTS                                        -->
    <!-- ====================================================================== -->
    <record id="action_lks_ppks_clients" model="ir.actions.act_window">
        <field name="name">Semua Penerima Manfaat (PPKS)</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_lks_ppks_client_search"/>
        <field name="domain">[('is_ppks', '=', True)]</field>
        <field name="context">{
            'default_is_ppks': True,
            'default_is_npo_beneficiary': True,
            'search_default_filter_active_service': 1,
        }</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_lks_ppks_client_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_lks_ppks_client_tree')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Daftarkan penerima manfaat sosial / klien binaan PPKS pertama Anda!
            </p>
            <p>
                Kelola 26 kategori PPKS Kemensos, buku induk registrasi, status residensial, dan pekerja sosial pendamping.
            </p>
        </field>
    </record>

    <record id="action_lks_ppks_in_facility" model="ir.actions.act_window">
        <field name="name">Klien Dalam Panti / Asrama (Residensial)</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_lks_ppks_client_search"/>
        <field name="domain">[('is_ppks', '=', True), ('residential_status', '=', 'in_facility')]</field>
        <field name="context">{
            'default_is_ppks': True,
            'default_is_npo_beneficiary': True,
            'default_residential_status': 'in_facility',
            'search_default_filter_active_service': 1,
        }</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_lks_ppks_client_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_lks_ppks_client_tree')}),
        ]"/>
    </record>

    <record id="action_lks_ppks_out_facility" model="ir.actions.act_window">
        <field name="name">Klien Luar Panti / Bina Keluarga</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_lks_ppks_client_search"/>
        <field name="domain">[('is_ppks', '=', True), ('residential_status', 'in', ['out_facility', 'day_care'])]</field>
        <field name="context">{
            'default_is_ppks': True,
            'default_is_npo_beneficiary': True,
            'default_residential_status': 'out_facility',
            'search_default_filter_active_service': 1,
        }</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_lks_ppks_client_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_lks_ppks_client_tree')}),
        ]"/>
    </record>
</odoo>
