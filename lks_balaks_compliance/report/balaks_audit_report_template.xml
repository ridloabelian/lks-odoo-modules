<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_balaks_audit_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="article page" style="font-family: 'Times New Roman', Times, serif; font-size: 12px; line-height: 1.4; color: #111;">
                    <!-- Kop Laporan -->
                    <div style="text-align: center; border-bottom: 3px double #000; padding-bottom: 10px; margin-bottom: 15px;">
                        <div style="font-size: 16px; font-weight: bold; text-transform: uppercase;">
                            <t t-esc="doc.company_id.name"/>
                        </div>
                        <div style="font-size: 13px; font-weight: bold;">
                            TIM PERSIAPAN AKREDITASI LEMBAGA KESEJAHTERAAN SOSIAL (BALAKS KEMENSOS)
                        </div>
                        <div style="font-size: 11px;">
                            Alamat: <t t-esc="doc.company_id.street"/>, <t t-esc="doc.company_id.city"/> | Telp: <t t-esc="doc.company_id.phone"/>
                        </div>
                    </div>

                    <!-- Judul -->
                    <div style="text-align: center; margin-bottom: 20px;">
                        <h4 style="margin: 0; font-weight: bold; text-decoration: underline; text-transform: uppercase;">
                            LEMBAR EVALUASI AUDIT KESIAPAN AKREDITASI 6 STANDAR NASIONAL
                        </h4>
                        <div style="font-size: 12px; margin-top: 4px;">
                            Sesi: <strong><t t-esc="doc.name"/></strong> | Tanggal: <t t-if="doc.audit_date" t-esc="doc.audit_date.strftime('%d %B %Y')"/>
                        </div>
                    </div>

                    <!-- Ringkasan Hasil Skor -->
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px; border: 1px solid #000;">
                        <tr style="background-color: #f3f4f6;">
                            <td style="width: 30%; padding: 8px; font-weight: bold; border: 1px solid #000;">Kluster Layanan Sasaran</td>
                            <td style="width: 70%; padding: 8px; border: 1px solid #000; text-transform: uppercase; font-weight: bold;"><t t-esc="doc.target_cluster"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; font-weight: bold; border: 1px solid #000;">Ketua Tim Asesor Internal</td>
                            <td style="padding: 8px; border: 1px solid #000;"><t t-esc="doc.auditor_id.name"/></td>
                        </tr>
                        <tr style="background-color: #ecfdf5;">
                            <td style="padding: 8px; font-weight: bold; border: 1px solid #000; color: #065f46;">Total Skor Terbobot</td>
                            <td style="padding: 8px; border: 1px solid #000; font-size: 16px; font-weight: bold; color: #047857;">
                                <t t-esc="doc.total_score"/> / 100.00 Poin
                            </td>
                        </tr>
                        <tr style="background-color: #ecfdf5;">
                            <td style="padding: 8px; font-weight: bold; border: 1px solid #000; color: #065f46;">Prediksi Peringkat Akreditasi</td>
                            <td style="padding: 8px; border: 1px solid #000; font-size: 15px; font-weight: bold; color: #047857;">
                                <t t-if="doc.accreditation_prediction == 'A'">AKREDITASI A (SANGAT BAIK / UNGGUL)</t>
                                <t t-elif="doc.accreditation_prediction == 'B'">AKREDITASI B (BAIK)</t>
                                <t t-elif="doc.accreditation_prediction == 'C'">AKREDITASI C (CUKUP)</t>
                                <t t-else="">TIDAK TERAKREDITASI (PERLU PEMBINAAN INTENSIF)</t>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; font-weight: bold; border: 1px solid #000;">Tingkat Kelengkapan Eviden</td>
                            <td style="padding: 8px; border: 1px solid #000;">
                                <t t-esc="doc.evidence_completeness_rate"/>% Berkas Eviden Lengkap
                            </td>
                        </tr>
                    </table>

                    <!-- Matriks Rincian Penilaian per Indikator -->
                    <div style="font-weight: bold; margin-bottom: 5px;">MATRIKS PENILAIAN INDIKATOR PER STANDAR NASIONAL:</div>
                    <table style="width: 100%; border-collapse: collapse; border: 1px solid #000; font-size: 11px; margin-bottom: 20px;">
                        <thead>
                            <tr style="background-color: #f3f4f6; text-align: center;">
                                <th style="border: 1px solid #000; padding: 5px; width: 12%;">Standar</th>
                                <th style="border: 1px solid #000; padding: 5px; width: 43%;">Parameter / Indikator</th>
                                <th style="border: 1px solid #000; padding: 5px; width: 10%;">Skor Maks</th>
                                <th style="border: 1px solid #000; padding: 5px; width: 10%;">Skor Riil</th>
                                <th style="border: 1px solid #000; padding: 5px; width: 13%;">Eviden</th>
                                <th style="border: 1px solid #000; padding: 5px; width: 12%;">Catatan</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.line_ids" t-as="l">
                                <tr>
                                    <td style="border: 1px solid #000; padding: 4px; text-align: center; font-weight: bold;">
                                        <t t-esc="l.standard_id.code"/>
                                    </td>
                                    <td style="border: 1px solid #000; padding: 4px;">
                                        <strong><t t-esc="l.indicator_id.code"/></strong>: <t t-esc="l.indicator_id.name"/>
                                    </td>
                                    <td style="border: 1px solid #000; padding: 4px; text-align: center;"><t t-esc="l.max_score"/></td>
                                    <td style="border: 1px solid #000; padding: 4px; text-align: center; font-weight: bold;"><t t-esc="l.score_obtained"/></td>
                                    <td style="border: 1px solid #000; padding: 4px; text-align: center;">
                                        <t t-if="l.evidence_status == 'complete'"><span style="color: green; font-weight: bold;">Lengkap</span></t>
                                        <t t-elif="l.evidence_status == 'partial'"><span style="color: orange; font-weight: bold;">Sebagian</span></t>
                                        <t t-else=""><span style="color: red; font-weight: bold;">Belum Ada</span></t>
                                    </td>
                                    <td style="border: 1px solid #000; padding: 4px;"><t t-esc="l.notes or '-'"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Rekomendasi Pemenuhan Dokumen -->
                    <div style="font-weight: bold; margin-bottom: 5px;">CATATAN REKOMENDASI PEMENUHAN EVIDEN &amp; TINDAK LANJUT:</div>
                    <div style="border: 1px solid #999; padding: 10px; margin-bottom: 25px; background-color: #fafafa;">
                        <p style="margin: 0;"><t t-esc="doc.recommendations or 'Lengkapi seluruh dokumen fisik SOP, pembukuan ISAK 35, dan STR Pekerja Sosial sebelum visitasi Kemensos.'"/></p>
                    </div>

                    <!-- Tanda Tangan -->
                    <table style="width: 100%; text-align: center; margin-top: 30px;">
                        <tr>
                            <td style="width: 50%;">
                                Mengetahui,<br/>
                                <strong>Kepala / Pimpinan LKS</strong><br/><br/><br/><br/>
                                ( _______________________________ )
                            </td>
                            <td style="width: 50%;">
                                <t t-esc="doc.company_id.city or 'Tempat'"/>, <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d %B %Y')"/><br/>
                                <strong>Ketua Tim Asesor Akreditasi Internal</strong><br/><br/><br/><br/>
                                ( <strong><t t-esc="doc.auditor_id.name"/></strong> )
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <template id="report_lks_profile_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="article page" style="font-family: 'Times New Roman', Times, serif; font-size: 13px; line-height: 1.5; color: #111;">
                    <!-- Kop Surat -->
                    <div style="text-align: center; border-bottom: 3px double #000; padding-bottom: 10px; margin-bottom: 20px;">
                        <table style="width: 100%;">
                            <tr>
                                <td style="width: 15%; text-align: left; vertical-align: middle;">
                                    <img t-if="doc.logo" t-att-src="image_data_uri(doc.logo)" style="max-height: 70px;"/>
                                </td>
                                <td style="width: 85%; text-align: center; vertical-align: middle;">
                                    <div style="font-size: 16px; font-weight: bold; text-transform: uppercase;">
                                        <t t-esc="doc.name"/>
                                    </div>
                                    <div style="font-size: 13px; font-weight: bold;">
                                        PROFIL RESMI LEMBAGA KESEJAHTERAAN SOSIAL (LKS)
                                    </div>
                                    <div style="font-size: 11px;">
                                        Laporan Registrasi &amp; Pemutakhiran Data Pokok untuk Dinas Sosial
                                    </div>
                                    <div style="font-size: 11px;">
                                        Alamat: <t t-esc="doc.street"/>, <t t-esc="doc.city"/> | Telp: <t t-esc="doc.phone"/> | Email: <t t-esc="doc.email"/>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- Judul -->
                    <div style="text-align: center; margin-bottom: 25px;">
                        <h4 style="margin: 0; font-weight: bold; text-decoration: underline; text-transform: uppercase;">
                            PROFIL KELEMBAGAAN &amp; DATA PELAYANAN SOSIAL
                        </h4>
                    </div>

                    <!-- Bagian I: Legalitas -->
                    <div style="background-color: #f3f4f6; font-weight: bold; padding: 5px 10px; border: 1px solid #999; margin-bottom: 10px;">
                        I. LEGALITAS &amp; PERIZINAN LEMBAGA KESEJAHTERAAN SOSIAL
                    </div>
                    <table style="width: 100%; margin-bottom: 15px; border-collapse: collapse;">
                        <tr>
                            <td style="width: 35%; padding: 4px;">1. Nama Resmi Lembaga</td>
                            <td style="width: 3%;">:</td>
                            <td style="width: 62%; font-weight: bold;"><t t-esc="doc.name"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 4px;">2. Nomor Tanda Daftar LKS (Dinsos)</td>
                            <td>:</td>
                            <td><strong><t t-esc="doc.lks_registration_number or '-'"/></strong></td>
                        </tr>
                        <tr>
                            <td style="padding: 4px;">3. Nomor Izin Operasional LKS</td>
                            <td>:</td>
                            <td><t t-esc="doc.lks_operational_permit or '-'"/> (Masa Berlaku s/d: <t t-if="doc.lks_permit_expiry_date" t-esc="doc.lks_permit_expiry_date.strftime('%d/%m/%Y')"/>)</td>
                        </tr>
                        <tr>
                            <td style="padding: 4px;">4. SK Pengesahan Kemenkumham RI</td>
                            <td>:</td>
                            <td><t t-esc="doc.kemenkumham_sk_number or '-'"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 4px;">5. Nomor Induk Berusaha (NIB OSS)</td>
                            <td>:</td>
                            <td><t t-esc="doc.nib_oss_number or '-'"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 4px;">6. Akreditasi BALAKS Kemensos RI</td>
                            <td>:</td>
                            <td>
                                <strong><t t-esc="doc.balaks_accreditation_grade or '-'"/></strong> 
                                (No. Sertifikat: <t t-esc="doc.balaks_certificate_number or '-/'"/>)
                            </td>
                        </tr>
                    </table>

                    <!-- Bagian II: Statistik Pelayanan & SDM -->
                    <div style="background-color: #f3f4f6; font-weight: bold; padding: 5px 10px; border: 1px solid #999; margin-bottom: 10px;">
                        II. STATISTIK PELAYANAN BINAAN PPKS &amp; RASIO SDM
                    </div>
                    <table style="width: 100%; margin-bottom: 25px; border-collapse: collapse;">
                        <tr>
                            <td style="width: 35%; padding: 4px;">1. Total Klien Binaan PPKS Aktif</td>
                            <td style="width: 3%;">:</td>
                            <td style="width: 62%; font-weight: bold;"><t t-esc="doc.total_active_clients"/> Orang</td>
                        </tr>
                        <tr>
                            <td style="padding: 4px;">2. Klien Residensial (Dalam Panti/Asrama)</td>
                            <td>:</td>
                            <td><t t-esc="doc.total_residential_clients"/> Orang</td>
                        </tr>
                        <tr>
                            <td style="padding: 4px;">3. Klien Luar Panti (Bina Keluarga / Day Care)</td>
                            <td>:</td>
                            <td><t t-esc="doc.total_active_clients - doc.total_residential_clients"/> Orang</td>
                        </tr>
                        <tr>
                            <td style="padding: 4px;">4. Jumlah Pekerja Sosial Bersertifikat</td>
                            <td>:</td>
                            <td><t t-esc="doc.total_social_workers"/> Orang</td>
                        </tr>
                        <tr>
                            <td style="padding: 4px;">5. Rasio Pekerja Sosial terhadap Klien</td>
                            <td>:</td>
                            <td><strong><t t-esc="doc.social_worker_client_ratio"/></strong> (Standar Nasional: 1 : 15 - 1 : 20)</td>
                        </tr>
                    </table>

                    <!-- Bagian III: Pengesahan -->
                    <table style="width: 100%; text-align: center; margin-top: 40px;">
                        <tr>
                            <td style="width: 50%;">
                                Mengetahui,<br/>
                                <strong>Dinas Sosial Setempat</strong><br/><br/><br/><br/>
                                ( _______________________________ )
                            </td>
                            <td style="width: 50%;">
                                <t t-esc="doc.city or 'Tempat'"/>, <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d %B %Y')"/><br/>
                                <strong>Kepala / Pimpinan LKS</strong><br/><br/><br/><br/>
                                ( _______________________________ )
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
