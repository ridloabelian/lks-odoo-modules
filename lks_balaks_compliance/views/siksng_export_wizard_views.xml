<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lks_siksng_export_wizard_form" model="ir.ui.view">
        <field name="name">lks.siksng.export.wizard.form</field>
        <field name="model">lks.siksng.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Ekspor Data Binaan Format SIKS-NG Kemensos &amp; Dinsos">
                <sheet>
                    <field name="state" invisible="1"/>
                    <t t-if="state == 'draft'">
                        <div class="alert alert-info text-center" role="alert">
                            <strong>Ekspor Data Penerima Manfaat PPKS Format Resmi SIKS-NG Kemensos RI</strong><br/>
                            Berkas yang dihasilkan berisi 34 kolom standar pelaporan Dinas Sosial &amp; SIKS-NG termasuk NIK, KK, Alamat Kemendagri, dan Pekerja Sosial Pendamping.
                        </div>
                        <group>
                            <group string="Filter Data Klien">
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="ppks_category_id" placeholder="Semua Kategori PPKS"/>
                                <field name="residential_status" widget="radio"/>
                            </group>
                            <group string="Status &amp; Format Berkas">
                                <field name="service_status" widget="radio"/>
                                <field name="file_format" widget="radio"/>
                            </group>
                        </group>
                    </t>
                    <t t-if="state == 'done'">
                        <div class="alert alert-success text-center" role="alert">
                            <i class="fa fa-check-circle fa-2x mb-2"/><br/>
                            <strong>File Data Binaan SIKS-NG Berhasil Digenerate!</strong><br/>
                            Silakan klik tautan di bawah ini untuk mengunduh berkas CSV.
                        </div>
                        <group>
                            <field name="export_filename" invisible="1"/>
                            <field name="export_file" filename="export_filename"/>
                        </group>
                    </t>
                </sheet>
                <footer>
                    <button name="action_generate_export" string="Generate Data Ekspor SIKS-NG" type="object"
                            class="oe_highlight" icon="fa-download" invisible="state != 'draft'"/>
                    <button string="Tutup" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_lks_siksng_export_wizard" model="ir.actions.act_window">
        <field name="name">Ekspor Data Binaan (SIKS-NG / Dinsos)</field>
        <field name="res_model">lks.siksng.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
