<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_isak35_inherit" model="ir.ui.view">
        <field name="name">account.move.form.isak35.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="after">
                <field name="isak35_restriction" widget="radio" options="{'horizontal': true}"/>
                <field name="donor_id" invisible="isak35_restriction != 'restricted'"/>
                <field name="program_cluster"/>
            </xpath>
        </field>
    </record>
</odoo>
